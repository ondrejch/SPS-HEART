{
  "metadata": {
    "name": "soft_resonance_branching_pdg2025_subset",
    "version": "2026-08-23.4-r2",
    "scope": "Branching constants used by the NA49 soft-resonance cascade subset for pi/K/p benchmarking.",
    "notes": [
      "Values are anchored to PDG 2025 summary/listing tables where available.",
      "When only a subset of channels is represented in code, listed channels are renormalized to unity.",
      "N* baryon states use representative central values from PDG ranges plus isospin-CG charge splitting.",
      "An effective high-mass N* tower is included to model unresolved Regge-like stacking and multi-step cascade feed-down.",
      "-1114 is exclusively the physical anti-Delta- (charge +1) since 2026-08-23; the legacy matter alias was removed."
    ]
  },
  "sources": {
    "pdg_2025_mesons": "https://pdg.lbl.gov/2025/tables/rpp2025-tab-mesons-light.pdf",
    "pdg_2025_baryons_n": "https://pdg.lbl.gov/2025/tables/rpp2025-tab-baryons-N.pdf",
    "pdg_2025_f2_listing": "https://pdg.lbl.gov/2025/listings/rpp2025-list-f2-1270.pdf",
    "fischer_2022_table9_context": "https://doi.org/10.1140/epjc/s10052-022-10855-7"
  },
  "assumptions": {
